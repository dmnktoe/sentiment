{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["dmnktoe"],
  "extends": [
    "config:recommended",
    ":enablePreCommit",
    ":preserveSemverRanges"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["ci"]
    },
    {
      "matchUpdateTypes": ["major", "minor"],
      "matchManagers": ["npm"],
      "addLabels": ["npm"]
    }
  ]
}
